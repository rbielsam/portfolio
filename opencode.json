{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "chrome-devtools": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest",
                "--no-usage-statistics"
            ]
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CTX7_API_KEY}"
            }
        },
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "/usr/bin/php",
                "/home/rbielsam/Projects/portfolio/Laravel/artisan",
                "boost:mcp"
            ]
        }
    }
}
